#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1648" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b2-p5" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1648" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e2-p5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr1-p5" target="walk-s1-hdr2-p5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr3-p5" value="&lt;b&gt;Lambda product → DynamoDB&lt;/b&gt;&lt;br&gt;PutItem table catalog, PK SKU#123&lt;br&gt;stream record with the new image" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2102" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b3-p5" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2102" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e3-p5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr2-p5" target="walk-s1-hdr3-p5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="frame-walk-s2-p5" value="" s