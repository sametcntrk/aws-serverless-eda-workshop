dth="28" height="28" as="geometry" /></mxCell><mxCell id="e-s4-3-p4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#C925D1;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.8333;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-lsms-p4" target="grp-eum-p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2910" y="860" /><mxPoint x="3090" y="860" /></Array></mxGeometry></mxCell><mxCell id="step-s4-3-p4" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2960" y="846" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s4-4-p4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#C925D1;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.6667;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8043;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-eum-p4" target="users-inbox-p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3110" y="1045" /></Array></mxGeometry></mxCell><mxCell id="step-s4-4-p4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="3200" y="1050" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s5-1-p4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-sns-p4" target="grp-sqsbo-p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-s5-1-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2657" y="1027" width="28" height="28" as="geometry" /></mxCell><mxCell id="legend-bg-L-p4" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-L-p4" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="60" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s1-L-p4" value="&lt;div style=&quot;font-size:16px;color:#007CBD&quot;&gt;&lt;b&gt;Scenario 1 - The fulfillment command goes to the 3PL&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The order buffer queue starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: page 3, Scenario 5, step 1b (OrderPlaced in the buffer).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s1-1-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="66" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-1-badge-legend-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-1-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-1-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The event source mapping polls the queue and invokes the function with a batch. The function reports only the failed items.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-1-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="126" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-badge-legend-p4" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-2-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-2-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Publish FulfillOrder&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function publishes a persistent FulfillOrder message to the fulfillment exchange over AMQPS. The broker confirms each message.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-2-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="186" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-badge-legend-p4" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-3-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-3-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;To the VPN&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The broker sends the message on the AMQPS connection that the WMS opened. Route table rtb-private-a sends 172.16.0.0/16 to vgw-shop.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-3-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-4-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="246" width="620" height="70" as="geometry" /></mxCell><mxCell id="step-s1-4-badge-legend-p4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-4-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-4-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Site-to-Site VPN carries the message to the customer gateway of the 3PL. The WMS reads the message and sends an ack. Return path: the ack goes back the same way to the broker.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-4-legend-p4"><mxGeometry x="52" y="0" width="568" height="70" as="geometry" /></mxCell><mxCell id="legend-head-s2-L-p4" value="&lt;div style=&quot;font-size:16px;color:#ED7100&quot;&gt;&lt;b&gt;Scenario 2 - The 3PL reports the shipment&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The 3PL WMS starts this flow when a parcel leaves the warehouse.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4"><mxGeometry x="0" y="336" width="620" height="46" as="geometry" /></mxCell><mxCell id="step-s2-1-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="386" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s2-1-badge-legend-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-1-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-1-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Publish ShipmentDispatched&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The WMS publishes the message to the shipments exchange over the VPN.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-1-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s2-2-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="432" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-2-badge-legend-p4" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-2-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-2-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Into the VPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The virtual private gateway delivers the packets to the broker. The broker stores the message in the queue shipments.events.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-2-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s2-3-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="492" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-3-badge-legend-p4" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-3-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-3-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The pipe reads batches from the queue. Its filter passes only ShipmentDispatched messages. An MQ source runs 5 pollers. A quota increase gives more.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-3-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s2-4-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="552" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s2-4-badge-legend-p4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-4-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-4-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Publish to the bus&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The pipe sends the event to the commerce bus with detail-type ShipmentDispatched.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-4-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s2-5-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p4" connectable="0"><mxGeometry x="0" y="598" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-5-badge-legend-p4" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-5-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-5-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Rule shipment-notify&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The rule sends the event to the notification topic. Scenarios 3 and 4 continue. Return path: none. The pipe acknowledges the messages after the delivery.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-5-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-bg-R-p4" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4290" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-R-p4" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="4310" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s3-R-p4" value="&lt;div style=&quot;font-size:16px;color:#7AA116&quot;&gt;&lt;b&gt;Scenario 3 - The customer gets an email&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The notification topic starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: page 3, Scenario 5, step 1a, or Scenario 2, step 5.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s3-1-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="66" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-1-badge-legend-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-1-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-1-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Fan-out&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The topic sends a copy to the email queue with raw message delivery.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-1-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-2-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="112" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-2-badge-legend-p4" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-2-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-2-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The event source mapping invokes the email function with a batch.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-2-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-3-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="158" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-3-badge-legend-p4" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-3-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-3-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Send the email&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function selects the template from the event type. It calls SendEmail with the configuration set.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-3-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s3-4-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="218" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-4-badge-legend-p4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-4-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-4-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;SES delivers the email to the mailbox of the customer. Return path: the configuration set sends bounce and complaint events to the EventBridge default bus.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-4-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s4-R-p4" value="&lt;div style=&quot;font-size:16px;color:#C925D1&quot;&gt;&lt;b&gt;Scenario 4 - The customer gets an SMS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The notification topic starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: the same event as Scenario 3.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4"><mxGeometry x="0" y="292" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s4-1-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="358" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-1-badge-legend-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-1-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-1-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Fan-out&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The topic sends a copy to the SMS queue. A filter policy passes only customers who accept SMS.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-1-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s4-2-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="418" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-2-badge-legend-p4" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-2-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-2-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The event source mapping invokes the SMS function.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-2-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s4-3-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="464" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-3-badge-legend-p4" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-3-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-3-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Send the SMS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function calls SendTextMessage of AWS End User Messaging SMS.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-3-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s4-4-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="510" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-4-badge-legend-p4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-4-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-4-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SMS goes to the phone of the customer. Return path: none.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-4-legend-p4"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="legend-head-s5-R-p4" value="&lt;div style=&quot;font-size:16px;color:#3F8624&quot;&gt;&lt;b&gt;Scenario 5 - The back office gets a copy&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The notification topic starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: the same event as Scenario 3.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4"><mxGeometry x="0" y="570" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s5-1-legend-p4" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4" connectable="0"><mxGeometry x="0" y="636" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-1-badge-legend-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-1-legend-p4"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-1-desc-legend-p4" value="&lt;div&gt;&lt;b&gt;Fan-out&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The topic sends a copy to the back-office queue. The back-office application reads it. That application is outside this design. Return path: none.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-1-legend-p4"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-lines-R-p4" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Solid colored arrow: one step of a scenario (the color is the scenario).&lt;br&gt;Dashed colored arrow: failure path.&lt;br&gt;Dotted grey line: association. No traffic flows on it.&lt;br&gt;Arc on a line: two lines cross. They do not connect.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4"><mxGeometry x="0" y="710" width="620" height="100" as="geometry" /></mxCell><mxCell id="legend-ips-R-p4" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Addresses&lt;/b&gt;&lt;br&gt;Private IPs come from the VPC plan (10.0.0.0/16) and the 3PL network (172.16.0.0/16). Internet addresses use the RFC 5737 documentation ranges.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p4"><mxGeometry x="0" y="824" width="620" height="68" as="geometry" /></mxCell><mxCell id="frame-walk-s1-p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#007CBD;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2556" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s1-title-p4" value="&lt;b style=&quot;color:#007CBD&quot;&gt;Scenario 1 - The fulfillment command goes to the 3PL - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2562" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s1-hdr0-p4" value="&lt;b&gt;SQS order buffer → Lambda fulfillment&lt;/b&gt;&lt;br&gt;SQS ReceiveMessage (event source mapping)&lt;br&gt;Records[].body = OrderPlaced event&lt;br&gt;ReportBatchItemFailures" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b0-p4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-hdr1-p4" value="&lt;b&gt;Lambda fulfillment → MQ node a&lt;/b&gt;&lt;br&gt;AMQP basic.publish, exchange fulfillment&lt;br&gt;routing key 3pl.orders, delivery_mode 2&lt;br&gt;type FulfillOrder, message_id o-1001" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b1-p4" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e1-p4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr0-p4" target="walk-s1-hdr1-p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr2-p4" value="&lt;b&gt;MQ node a → Virtual private gateway&lt;/b&gt;&lt;br&gt;AMQPS 5671&lt;br&gt;src 10.0.16.40 (MQ node a private IP)&lt;br&gt;dst 172.16.10.5 (3PL WMS private IP)" style="text;html=