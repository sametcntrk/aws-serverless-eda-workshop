ontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="917" y="497" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s5-3-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-wsapi-p2" target="grp-lws-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-s5-3-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1117" y="627" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s5-4-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5833;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-lws-p2" target="grp-ddb-p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="760" /><mxPoint x="1240" y="1230" /><mxPoint x="1520" y="1230" /></Array></mxGeometry></mxCell><mxCell id="step-s5-4-p2" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1187" y="727" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s6-1-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#E7157B;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.2771;exitDx=0;exitDy=0;entryX=0;entryY=0.7375;entryDx=0;entryDy=0;" edge="1" parent="1" source="users-customer-p2" target="grp-cf-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-s6-1-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1106" y="336" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s6-2-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#E7157B;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.9167;exitY=1;exitDx=0;exitDy=0;entryX=0.9167;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-cf-p2" target="grp-apigw-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-s6-2-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1366" y="410" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s6-3-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#E7157B;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.9167;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=-0.125;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-apigw-p2" target="grp-sfn-p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="632" /><mxPoint x="1660" y="632" /><mxPoint x="1660" y="875" /></Array></mxGeometry></mxCell><mxCell id="step-s6-3-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1667" y="740" width="28" height="28" as="geometry" /></mxCell><mxCell id="legend-bg-L-p2" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-L-p2" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="60" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s1-L-p2" value="&lt;div style=&quot;font-size:16px;color:#007CBD&quot;&gt;&lt;b&gt;Scenario 1 - The browser loads the SPA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The customer browser starts this flow. It needs the static files of the single-page application (SPA).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s1-1-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="66" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-1-badge-legend-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-1-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-1-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;DNS lookup&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser asks for shop.tdsynnexlab.link. Route 53 answers with an alias record that points to the CloudFront distribution.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-1-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="126" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-badge-legend-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-2-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-2-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;HTTPS request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser sends GET / over HTTPS. AWS WAF checks the request at CloudFront. CloudFront sends a cached copy when it has one.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-2-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="186" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-badge-legend-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-3-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-3-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Origin request on a cache miss&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront signs the request with origin access control (OAC). Only CloudFront can read the bucket. Return path: S3 → CloudFront → browser.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-3-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s2-L-p2" value="&lt;div style=&quot;font-size:16px;color:#ED7100&quot;&gt;&lt;b&gt;Scenario 2 - The customer signs in&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The customer browser starts this flow. It needs tokens for the protected APIs.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2"><mxGeometry x="0" y="260" width="620" height="46" as="geometry" /></mxCell><mxCell id="step-s2-1-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="310" width="620" height="70" as="geometry" /></mxCell><mxCell id="step-s2-1-badge-legend-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-1-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-1-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Sign-in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SPA sends the email and the password to the Cognito user pool with SRP. Cognito asks for MFA when the customer turned it on. Return path: Cognito sends the ID, access and refresh tokens (JWT) to the browser.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-1-legend-p2"><mxGeometry x="52" y="0" width="568" height="70" as="geometry" /></mxCell><mxCell id="legend-head-s3-L-p2" value="&lt;div style=&quot;font-size:16px;color:#7AA116&quot;&gt;&lt;b&gt;Scenario 3 - The customer searches for products&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The customer browser starts this flow. Search is public and needs no token.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 1 (the SPA runs in the browser).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2"><mxGeometry x="0" y="400" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s3-1-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="466" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-1-badge-legend-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-1-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-1-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Search request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SPA sends GET /api/products?q=laptop. WAF checks the request. The /api/* cache behavior sends it to the REST API origin.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-1-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s3-2-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="526" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-2-badge-legend-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-2-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-2-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Origin request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront sends the request to the regional REST API. The request validator checks the query parameters.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-2-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s3-3-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="586" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-3-badge-legend-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-3-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-3-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Lambda proxy integration&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the product function. The event contains the full request.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-3-legend-p2"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-4-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="632" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-4-badge-legend-p2" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-4-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-4-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Full-text search&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function sends a search query to the products index. The index returns the matching SKUs.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-4-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s3-5-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="692" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-5-badge-legend-p2" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-5-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-5-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Current price and stock&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function reads price and stock for the SKUs with BatchGetItem. Return path: Lambda → API Gateway → CloudFront → browser.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-5-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s4-L-p2" value="&lt;div style=&quot;font-size:16px;color:#C925D1&quot;&gt;&lt;b&gt;Scenario 4 - The customer adds an item to the cart&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The signed-in customer starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 2 (the ID token).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2"><mxGeometry x="0" y="766" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s4-1-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="832" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-1-badge-legend-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-1-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-1-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Cart request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SPA sends POST /api/cart/items. The Authorization header carries the ID token.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-1-legend-p2"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s4-2-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="878" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-2-badge-legend-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-2-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-2-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Token check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Cognito authorizer checks the signature and the expiry of the JWT. The request validator checks the JSON body.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-2-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s4-3-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="938" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-3-badge-legend-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-3-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-3-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the cart function. The event carries the token claims (sub is the customer ID).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-3-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s4-4-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p2" connectable="0"><mxGeometry x="0" y="998" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-4-badge-legend-p2" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-4-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-4-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Cart write&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function updates the cart item and sets expiresAt. DynamoDB TTL deletes old carts. Return path: Lambda → API Gateway → CloudFront → browser.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-4-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-bg-R-p2" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4290" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-R-p2" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="4310" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s5-R-p2" value="&lt;div style=&quot;font-size:16px;color:#3F8624&quot;&gt;&lt;b&gt;Scenario 5 - The browser opens the WebSocket&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser opens this connection before the checkout. Page 3 uses it to push the checkout result.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 2 (the ID token).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2"><mxGeometry x="0" y="0" width="620" height="78" as="geometry" /></mxCell><mxCell id="step-s5-1-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="82" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-1-badge-legend-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-1-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-1-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;DNS lookup&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser asks for ws.shop.tdsynnexlab.link. Route 53 answers with an alias to the custom domain of the WebSocket API.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-1-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s5-2-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="142" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-2-badge-legend-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-2-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-2-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;WebSocket upgrade&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser opens wss://ws.shop.tdsynnexlab.link with the token. A Lambda authorizer checks the Cognito token on the $connect route.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-2-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s5-3-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="202" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s5-3-badge-legend-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-3-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-3-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;$connect route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the ws function with the connection ID.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-3-legend-p2"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s5-4-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="248" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-4-badge-legend-p2" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-4-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-4-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Store the connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes the connection ID with the customer ID and a TTL. Return path: API Gateway sends 101 Switching Protocols. The connection stays open.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-4-legend-p2"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s6-R-p2" value="&lt;div style=&quot;font-size:16px;color:#E7157B&quot;&gt;&lt;b&gt;Scenario 6 - The customer starts the checkout&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The signed-in customer starts this flow from the cart page.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 4 (the cart) and Scenario 5 (the open WebSocket).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2"><mxGeometry x="0" y="322" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s6-1-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="388" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s6-1-badge-legend-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-1-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-1-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Checkout request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SPA sends POST /api/checkout with the ID token and an Idempotency-Key header.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-1-legend-p2"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s6-2-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="434" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s6-2-badge-legend-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-2-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-2-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Token check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Cognito authorizer checks the token. The request validator checks the body.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-2-legend-p2"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s6-3-legend-p2" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2" connectable="0"><mxGeometry x="0" y="480" width="620" height="70" as="geometry" /></mxCell><mxCell id="step-s6-3-badge-legend-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-3-legend-p2"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-3-desc-legend-p2" value="&lt;div&gt;&lt;b&gt;Direct integration&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway calls StartExecution. The execution name is the Idempotency-Key, so a retry does not start a second saga. Return path: API Gateway sends 202 to the browser. Page 3 continues the saga.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-3-legend-p2"><mxGeometry x="52" y="0" width="568" height="70" as="geometry" /></mxCell><mxCell id="legend-lines-R-p2" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Solid colored arrow: one step of a scenario (the color is the scenario).&lt;br&gt;Dashed colored arrow: failure path.&lt;br&gt;Dotted grey line: association. No traffic flows on it.&lt;br&gt;Arc on a line: two lines cross. They do not connect.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p2"><mxGeometry x="0" y="570" width="620" height="100" as="geometry" /></mxCell><mxCell id="frame-walk-s1-p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#007CBD;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2556" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s1-title-p2" value="&lt;b style=&quot;color:#007CBD&quot;&gt;Scenario 1 - The browser loads the SPA - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2562" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s1-hdr0-p2" value="&lt;b&gt;Customer → Route 53&lt;/b&gt;&lt;br&gt;DNS query: shop.tdsynnexlab.link (A, AAAA)&lt;br&gt;Answer: alias to dxxxx.cloudfront.net" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b0-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-hdr1-p2" value="&lt;b&gt;Customer → CloudFront&lt;/b&gt;&lt;br&gt;HTTPS GET /&lt;br&gt;Host: shop.tdsynnexlab.link&lt;br&gt;TLS certificate: ACM in us-east-1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b1-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e1-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr0-p2" target="walk-s1-hdr1-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr2-p2" value="&lt;b&gt;CloudFront → S3 web bucket&lt;/b&gt;&lt;br&gt;S3 GetObject /index.html&lt;br&gt;Authorization: SigV4 (OAC)&lt;br&gt;Response: 200 with Cache-Control" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1648" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b2-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1648" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e2-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr1-p2" target="walk-s1-hdr2-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="frame-walk-s2-p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2764" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s2-title-p2" value="&lt;b style=&quot;color:#ED7100&quot;&gt;Scenario 2 - The customer signs in - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2770" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s2-hdr0-p2" value="&lt;b&gt;Customer → Cognito&lt;/b&gt;&lt;br&gt;InitiateAuth USER_SRP_AUTH&lt;br&gt;USERNAME = email, SRP_A&lt;br&gt;Result: IdToken, AccessToken, RefreshToken" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="2853" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s2-b0-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="2808" width="28" height="28" as="geometry" /></mxCell><mxCell id="frame-walk-s3-p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7AA116;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2972" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s3-title-p2" value="&lt;b style=&quot;color:#7AA116&quot;&gt;Scenario 3 - The customer searches for products - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2978" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s3-hdr0-p2" value="&lt;b&gt;Customer → CloudFront&lt;/b&gt;&lt;br&gt;HTTPS GET /api/products?q=laptop&amp;page=1&lt;br&gt;Host: shop.tdsynnexlab.link" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="3061" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s3-b0-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="3016" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s3-hdr1-p2" value="&lt;b&gt;CloudFront → REST API&lt;/b&gt;&lt;br&gt;HTTPS GET /prod/products?q=laptop&lt;br&gt;X-Forwarded-For: client IP" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="3061" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s3-b1-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="3016" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s3-e1-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s3-hdr0-p2" target="walk-s3-hdr1-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s3-hdr2-p2" value="&lt;b&gt;REST API → Lambda product&lt;/b&gt;&lt;br&gt;Lambda event (proxy)&lt;br&gt;httpMethod GET, path /products&lt;br&gt;queryStringParameters.q = laptop" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1648" y="3061" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s3-b2-p2" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1648" y="3016" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s3-e2-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s3-hdr1-p2" target="walk-s3-hdr2-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s3-hdr3-p2" value="&lt;b&gt;Lambda product → OpenSearch&lt;/b&gt;&lt;br&gt;POST /products/_search&lt;br&gt;match name: laptop, size 20&lt;br&gt;SigV4 (service aoss)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2102" y="3061" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s3-b3-p2" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2102" y="3016" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s3-e3-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s3-hdr2-p2" target="walk-s3-hdr3-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s3-hdr4-p2" value="&lt;b&gt;Lambda product → DynamoDB&lt;/b&gt;&lt;br&gt;BatchGetItem table catalog&lt;br&gt;Keys: PK = SKU#123, ...&lt;br&gt;ProjectionExpression price, stock" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2556" y="3061" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s3-b4-p2" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2556" y="3016" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s3-e4-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s3-hdr3-p2" target="walk-s3-hdr4-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="frame-walk-s4-p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C925D1;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="3180" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s4-title-p2" value="&lt;b style=&quot;color:#C925D1&quot;&gt;Scenario 4 - The customer adds an item to the cart - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="3186" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s4-hdr0-p2" value="&lt;b&gt;Customer → CloudFront&lt;/b&gt;&lt;br&gt;HTTPS POST /api/cart/items&lt;br&gt;Authorization: Bearer &amp;lt;ID token&amp;gt;&lt;br&gt;body {sku: SKU#123, qty: 1}" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="3269" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s4-b0-p2" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="3224" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s4-hdr1-p2" value="&lt;b&gt;CloudFront → REST API&lt;/b&gt;&lt;br&gt;Origin request /prod/cart/items&lt;br&gt;authorizer: claims.sub = c-42" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="3269" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s4-b1-p2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="3224" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s4-e1-p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s4-hdr0-p2" target="walk-s4-hdr1-p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s4-hdr2-p2" value="&lt;b&gt;REST API → Lambda cart&lt;/b&gt;&lt;br&gt;Lambda event&lt;br&gt;requestContext.authorizer.