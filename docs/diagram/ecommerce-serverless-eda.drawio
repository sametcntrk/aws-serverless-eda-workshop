x="2437" y="645" width="28" height="28" as="geometry" /></mxCell><mxCell id="legend-bg-L-p5" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-L-p5" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="60" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s1-L-p5" value="&lt;div style=&quot;font-size:16px;color:#007CBD&quot;&gt;&lt;b&gt;Scenario 1 - The admin saves a product&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A back-office admin starts this flow from the admin pages of the SPA.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: the admin signed in with MFA (as on page 2, Scenario 2).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s1-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="66" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s1-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Admin request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The admin pages send PUT /api/admin/products/SKU#123 with the ID token.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s1-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="112" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Token and group check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The authorizer accepts only tokens with the admins group claim. The request validator checks the product body.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="172" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s1-3-badge-legend-p5" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-3-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-3-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the product function on the admin route.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-3-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s1-4-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="218" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-4-badge-legend-p5" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-4-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-4-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Write the product&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes the product item. DynamoDB Streams records the change. Return path: Lambda → API Gateway → CloudFront → admin.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-4-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s2-L-p5" value="&lt;div style=&quot;font-size:16px;color:#ED7100&quot;&gt;&lt;b&gt;Scenario 2 - Zero-ETL copies the change to OpenSearch&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The DynamoDB stream starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 1 (the stream record).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5"><mxGeometry x="0" y="292" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s2-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="358" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Read the stream&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The OpenSearch Ingestion pipeline of the zero-ETL integration reads the DynamoDB stream. The first full copy came from a point-in-time recovery (PITR) export.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s2-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="418" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Index the document&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The pipeline writes the document to the products index. Search shows the change after a short delay. Return path: none.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s3-L-p5" value="&lt;div style=&quot;font-size:16px;color:#7AA116&quot;&gt;&lt;b&gt;Scenario 3 - The admin gets a presigned upload URL&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A back-office admin starts this flow before an image upload.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: the admin signed in with MFA.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5"><mxGeometry x="0" y="492" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s3-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="558" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The admin pages send POST /api/admin/images/upload-url with the ID token.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="604" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Token and group check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The authorizer accepts only tokens with the admins group claim.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-3-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="650" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-3-badge-legend-p5" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-3-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-3-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Sign the URL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function signs a PUT URL for the uploads bucket. It does not call S3. Return path: the URL goes back to the admin. The URL expires after a short time (for example 5 minutes).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-3-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s4-L-p5" value="&lt;div style=&quot;font-size:16px;color:#C925D1&quot;&gt;&lt;b&gt;Scenario 4 - The admin browser uploads the image&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The admin browser starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 3 (the presigned URL).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5"><mxGeometry x="0" y="724" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s4-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="790" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Upload&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser sends the file with HTTPS PUT to the presigned URL. The upload does not use CloudFront or API Gateway. Return path: S3 sends 200 to the browser.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s5-L-p5" value="&lt;div style=&quot;font-size:16px;color:#3F8624&quot;&gt;&lt;b&gt;Scenario 5 - S3 starts the image resize&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The uploads bucket starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 4 (the new object).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5"><mxGeometry x="0" y="864" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s5-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="930" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Object Created event&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The bucket sends an Object Created event to the EventBridge default bus. S3 sends its events only to the default bus.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s5-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="990" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Rule image-uploaded&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The rule matches the uploads bucket and invokes the resize function. A DLQ keeps failed deliveries.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s5-3-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="1050" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s5-3-badge-legend-p5" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-3-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-3-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Read the original&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function reads the original image with GetObject.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-3-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s5-4-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p5" connectable="0"><mxGeometry x="0" y="1096" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-4-badge-legend-p5" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-4-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-4-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Write the sizes&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes three sizes to the web bucket. CloudFront serves them under /images/*. Return path: none. The separate bucket prevents a resize loop.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-4-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-bg-R-p5" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4290" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-R-p5" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="4310" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s6-R-p5" value="&lt;div style=&quot;font-size:16px;color:#E7157B&quot;&gt;&lt;b&gt;Scenario 6 - The browser sends clickstream events&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The customer browser starts this flow while the customer uses the shop.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: page 2, Scenario 1 (the SPA runs).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s6-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="66" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s6-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Event batch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SPA sends POST /api/events with a batch of page views and clicks.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s6-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="112" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s6-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Origin request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront sends the batch to the REST API. Throttling on the /events route limits the request rate.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s6-3-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="172" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s6-3-badge-legend-p5" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-3-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-3-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the producer function. The function runs in the VPC because the browser cannot speak Kafka.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-3-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s6-4-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="232" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s6-4-badge-legend-p5" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7157B;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s6-4-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s6-4-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Produce&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes the events to the topic clickstream. The key is the session ID. Return path: Lambda → API Gateway → CloudFront → browser (202).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s6-4-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s7-R-p5" value="&lt;div style=&quot;font-size:16px;color:#00A4A6&quot;&gt;&lt;b&gt;Scenario 7 - A consumer writes the data lake&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;MSK Serverless starts this flow through an event source mapping.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 6 (or page 3, Scenario 5, step 2 for commerce events).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5"><mxGeometry x="0" y="306" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s7-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="372" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s7-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00A4A6;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s7-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s7-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The event source mapping in provisioned mode reads batches. Its consumer group is archive.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s7-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s7-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="432" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s7-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00A4A6;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s7-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s7-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Write a batch file&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes one file for each batch. The object key has date and hour partitions. The marketing team queries this data. Return path: none.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s7-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s8-R-p5" value="&lt;div style=&quot;font-size:16px;color:#545B64&quot;&gt;&lt;b&gt;Scenario 8 - A consumer counts popular products&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;MSK Serverless starts this flow through a second event source mapping.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 6.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5"><mxGeometry x="0" y="506" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s8-1-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="572" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s8-1-badge-legend-p5" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#545B64;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s8-1-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s8-1-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A second event source mapping reads the same topic. Its consumer group is counters.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s8-1-legend-p5"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s8-2-legend-p5" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5" connectable="0"><mxGeometry x="0" y="618" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s8-2-badge-legend-p5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#545B64;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s8-2-legend-p5"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s8-2-desc-legend-p5" value="&lt;div&gt;&lt;b&gt;Update the counters&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function adds the view counts for each SKU with an atomic ADD. The product function reads these counters. Return path: none.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s8-2-legend-p5"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-lines-R-p5" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Solid colored arrow: one step of a scenario (the color is the scenario).&lt;br&gt;Dashed colored arrow: failure path.&lt;br&gt;Dotted grey line: association. No traffic flows on it.&lt;br&gt;Arc on a line: two lines cross. They do not connect.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p5"><mxGeometry x="0" y="692" width="620" height="100" as="geometry" /></mxCell><mxCell id="frame-walk-s1-p5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#007CBD;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2556" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s1-title-p5" value="&lt;b style=&quot;color:#007CBD&quot;&gt;Scenario 1 - The admin saves a product - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2562" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s1-hdr0-p5" value="&lt;b&gt;Admin → CloudFront&lt;/b&gt;&lt;br&gt;HTTPS PUT /api/admin/products/SKU%23123&lt;br&gt;Authorization: Bearer &amp;lt;ID token&amp;gt;&lt;br&gt;body {name, price, attributes}" style="text;html=1;align=left;verticalAlign=t