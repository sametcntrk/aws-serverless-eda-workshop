90" /></Array></mxGeometry></mxCell><mxCell id="e-j13-0-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.1667;exitDx=0;exitDy=0;entryX=0;entryY=0.1667;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-eb-p1" target="grp-sns-p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-j13-0-p1" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2067" y="877" width="36" height="28" as="geometry" /></mxCell><mxCell id="e-j13-1-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.8333;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-sns-p1" target="grp-sqsmail-p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2690" y="1025" /><mxPoint x="3280" y="1025" /></Array></mxGeometry></mxCell><mxCell id="e-j13-2-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-sqsmail-p1" target="grp-lmail-p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-j13-3-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.8333;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-lmail-p1" target="grp-ses-p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3350" y="855" /><mxPoint x="3530" y="855" /></Array></mxGeometry></mxCell><mxCell id="e-j13-4-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3913;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-ses-p1" target="users-inbox-p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-j14-0-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.1667;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-sfn-p1" target="grp-lws-p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1730" y="855" /><mxPoint x="1140" y="855" /></Array></mxGeometry></mxCell><mxCell id="step-j14-0-p1" value="14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1450" y="841" width="36" height="28" as="geometry" /></mxCell><mxCell id="e-j14-1-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-lws-p1" target="grp-wsapi-p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-j14-2-p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#007CBD;rounded=0;strokeWidth=2.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0;exitY=0.5833;exitDx=0;exitDy=0;entryX=1;entryY=0.5934;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-wsapi-p1" target="users-customer-p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend-bg-L-p1" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-L-p1" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="60" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-j-L-p1" value="&lt;div style=&quot;font-size:16px;color:#007CBD&quot;&gt;&lt;b&gt;Main customer journey (14 steps)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The customer starts the journey in the browser. One number can cover several arrows. Pages 2 to 5 show every step in detail, with an event walk.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-j-1-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="66" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-1-badge-legend-p1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-1-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-1-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Customer → CloudFront&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser loads the SPA and calls /api/* through CloudFront. AWS WAF checks every request.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-1-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-2-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="126" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-2-badge-legend-p1" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-2-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-2-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;CloudFront → REST API&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront sends /api/* to the regional REST API. The Cognito authorizer checks the token on protected routes.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-2-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-3-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="186" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-3-badge-legend-p1" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-3-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-3-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Search&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The product function searches the OpenSearch Serverless index. Page 2 shows the price and stock read from DynamoDB.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-3-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-4-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="246" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-j-4-badge-legend-p1" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-4-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-4-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Cart&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The cart function writes the cart item to DynamoDB. DynamoDB TTL deletes old carts.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-4-legend-p1"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-j-5-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="292" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-5-badge-legend-p1" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-5-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-5-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Checkout start&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The REST API starts the checkout-saga execution directly. The execution name is the Idempotency-Key.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-5-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-6-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="352" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-j-6-badge-legend-p1" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-6-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-6-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Stock reservation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The saga reserves the stock with a conditional UpdateItem in DynamoDB.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-6-legend-p1"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-j-7-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="398" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-7-badge-legend-p1" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-7-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-7-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Payment request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The saga invokes the payment function with a task token. The function calls the payment provider through the NAT gateway and the internet gateway.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-7-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-8-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="458" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-8-badge-legend-p1" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-8-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-8-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Payment callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The provider sends the webhook through CloudFront and the REST API. The webhook function checks the signature and calls SendTaskSuccess.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-8-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-9-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="518" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-j-9-badge-legend-p1" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-9-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-9-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Order write&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The order function writes the order to the Aurora writer through RDS Proxy.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-9-legend-p1"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-j-10-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="564" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-j-10-badge-legend-p1" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-10-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-10-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;OrderPlaced&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The saga publishes OrderPlaced on the commerce bus.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-10-legend-p1"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-j-11-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="610" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-11-badge-legend-p1" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-11-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-11-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Fulfillment&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A rule sends OrderPlaced to the order buffer queue. The fulfillment function publishes FulfillOrder to Amazon MQ. The 3PL WMS reads the message over the Site-to-Site VPN.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-11-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-12-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="670" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-12-badge-legend-p1" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-12-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-12-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Shipment&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The WMS publishes ShipmentDispatched to Amazon MQ. EventBridge Pipes sends it to the commerce bus.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-12-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-13-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="730" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-13-badge-legend-p1" value="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-13-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-13-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Email&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A rule sends the event to SNS. SNS sends a copy to the email queue. The email function sends the email with SES.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-13-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-j-14-legend-p1" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p1" connectable="0"><mxGeometry x="0" y="790" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-j-14-badge-legend-p1" value="14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-j-14-legend-p1"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-j-14-desc-legend-p1" value="&lt;div&gt;&lt;b&gt;Result push&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The saga invokes the ws function. The function posts the checkout result to the open WebSocket. Return path: none. The push goes one way.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-j-14-legend-p1"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-bg-R-p1" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4290" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-R-p1" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="4310" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-dec-R-p1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Key decisions&lt;/b&gt;&lt;br&gt;One account, one Region (eu-central-1), three AZs. Production models everywhere: Multi-AZ, clusters, standby replicas.&lt;br&gt;MQ, MSK, SQS and DynamoDB Streams deliver at least once. Every consumer is idempotent (DynamoDB idempotency keys). Every asynchronous target has a DLQ.&lt;br&gt;Private-app subnets reach the internet only through the NAT gateway of their AZ. Only the payment calls use it. Private-data subnets have no route to the internet.&lt;br&gt;Gateway endpoints carry S3 and DynamoDB traffic. Interface endpoints carry EventBridge, Step Functions, SNS, SQS, Secrets Manager, STS and CloudWatch Logs traffic. AWS delivers that traffic privately on the AWS backbone.&lt;br&gt;The VGW route to 172.16.0.0/16 is propagated from the Site-to-Site VPN.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#6c8ebf;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p1"><mxGeometry x="0" y="0" width="620" height="196" as="geometry" /></mxCell><mxCell id="legend-sg-R-p1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Security groups&lt;/b&gt;&lt;table style=&quot;width:560px;font-size:11px;border-collapse:collapse;margin-top:4px&quot;&gt;&lt;tr style=&quot;background:#E6E6E6;color:#333333&quot;&gt;&lt;td&gt;&lt;b&gt;Source&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Destination&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Port&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-lambda-vpc&lt;/td&gt;&lt;td&gt;sg-proxy&lt;/td&gt;&lt;td&gt;TCP 5432&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-proxy&lt;/td&gt;&lt;td&gt;sg-aurora&lt;/td&gt;&lt;td&gt;TCP 5432&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-lambda-vpc&lt;/td&gt;&lt;td&gt;sg-mq&lt;/td&gt;&lt;td&gt;TCP 5671 (AMQPS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pipes ENIs (broker VPC settings)&lt;/td&gt;&lt;td&gt;sg-mq&lt;/td&gt;&lt;td&gt;TCP 5671&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;172.16.0.0/16 (3PL over VPN)&lt;/td&gt;&lt;td&gt;sg-mq&lt;/td&gt;&lt;td&gt;TCP 5671&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-lambda-vpc&lt;/td&gt;&lt;td&gt;sg-msk&lt;/td&gt;&lt;td&gt;TCP 9098 (IAM)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MSK event source mappings&lt;/td&gt;&lt;td&gt;sg-msk&lt;/td&gt;&lt;td&gt;TCP 9098&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-lambda-vpc&lt;/td&gt;&lt;td&gt;sg-vpce&lt;/td&gt;&lt;td&gt;TCP 443&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sg-lambda-vpc (payment)&lt;/td&gt;&lt;td&gt;0.0.0.0/0 through NAT&lt;/td&gt;&lt;td&gt;TCP 443&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#DD344C;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p1"><mxGeometry x="0" y="210" width="620" height="220" as="geometry" /></mxCell><mxCell id="legend-aux-R-p1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Security and observability (no arrows)&lt;/b&gt;&lt;br&gt;Secrets Manager keeps the MQ, Aurora and payment provider credentials. AWS KMS customer managed keys encrypt the data. Lambda Powertools, X-Ray and CloudWatch alarms (DLQ depth, Pipes and ESM errors) give observability.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p1"><mxGeometry x="0" y="444" width="620" height="84" as="geometry" /></mxCell><mxCell id="legend-cert-R-p1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Certificates and names&lt;/b&gt;&lt;br&gt;ACM in us-east-1 for CloudFront (shop.tdsynnexlab.link). ACM in eu-central-1 for the WebSocket API (ws.shop.tdsynnexlab.link).&lt;br&gt;&lt;i&gt;Open item: the user confirms the two domain names. The zone has no such records today.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#DD344C;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p1"><mxGeometry x="0" y="542" width="620" height="84" as="geometry" /></mxCell><mxCell id="legend-az-R-p1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Availability Zones&lt;/b&gt;&lt;br&gt;Each AZ has the same components. Arrows go only to AZ-a. The Lambda, RDS Proxy, MSK and endpoint icons in the subnets are the ENIs of regional services.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#147EBA;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p1"><mxGeometry x="0" y="640" width="620" height="68" as="geometry" /></mxCell><mxCell id="legend-lines-R-p1" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Blue numbered arrow: one step of the main customer journey. One number can cover several arrows.&lt;br&gt;Grey arrow: another connection. Pages 2 to 5 show it as a step.&lt;br&gt;Dashed arrow: failure path.&lt;br&gt;Dotted grey line: association. No traffic flows on it.&lt;br&gt;Arc on a line: two lines cross. They do not connect.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p1"><mxGeometry x="0" y="722" width="620" height="132" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="2 Customer (synchronous)" i