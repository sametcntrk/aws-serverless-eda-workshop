ue="&lt;b&gt;Bus commerce → SNS topic&lt;/b&gt;&lt;br&gt;SNS Publish, topic order-notifications&lt;br&gt;MessageAttributes eventType = OrderPlaced" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="3507" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s5-b0-p3" value="1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="3462" width="36" height="28" as="geometry" /></mxCell><mxCell id="walk-s5-hdr1-p3" value="&lt;b&gt;Bus commerce → SQS order buffer&lt;/b&gt;&lt;br&gt;SQS SendMessage, queue order-buffer&lt;br&gt;body = the event JSON" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="3507" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s5-b1-p3" value="1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="3462" width="36" height="28" as="geometry" /></mxCell><mxCell id="walk-s5-e1-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#3F8624;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s5-hdr0-p3" target="walk-s5-hdr1-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s5-hdr2-p3" value="&lt;b&gt;Bus commerce → Lambda producer&lt;