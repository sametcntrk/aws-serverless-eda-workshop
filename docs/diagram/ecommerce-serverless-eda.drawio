=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.1667;exitDx=0;exitDy=0;entryX=0;entryY=0.1667;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-eb-p3" target="grp-sns-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-s5-1a-p3" value="1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2067" y="877" width="36" height="28" as="geometry" /></mxCell><mxCell id="e-s5-1b-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.2917;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-eb-p3" target="grp-sqsbuf-p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1965" y="1035" /><mxPoint x="1770" y="1035" /></Array></mxGeometry></mxCell><mxCell id="step-s5-1b-p3" value="1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1860" y="992" width="36" height="28" as="geometry" /></mxCell><mxCell id="e-s5-1c-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=1;exitY=0.7083;exitDx=0;exitDy=0;entryX=0.625;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-eb-p3" target="grp-lprodc-p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2100" y="975" /><mxPoint x="2100" y="1490" /><mxPoint x="1630" y="1490" /></Array></mxGeometry></mxCell><mxCell id="step-s5-1c-p3" value="1c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2058" y="1110" width="36" height="28" as="geometry" /></mxCell><mxCell id="e-s5-2-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp-lprodc-p3" target="grp-msk-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="step-s5-2-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1622" y="1917" width="28" height="28" as="geometry" /></mxCell><mxCell id="e-s5-3-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;endFill=1;strokeColor=#3F8624;rounded=0;strokeWidth=2;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;exitX=0.6667;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="grp-eb-p3" target="grp-dlq-p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2010" y="1045" /><mxPoint x="2430" y="1045" /></Array></mxGeometry></mxCell><mxCell id="step-s5-3-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2300" y="1004" width="28" height="28" as="geometry" /></mxCell><mxCell id="legend-bg-L-p3" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-L-p3" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="60" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s1-L-p3" value="&lt;div style=&quot;font-size:16px;color:#007CBD&quot;&gt;&lt;b&gt;Scenario 1 - The saga reserves stock and asks for payment&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Step Functions Standard workflow checkout-saga starts this flow.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: page 2, Scenario 6 (the execution started).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s1-1-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="66" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-1-badge-legend-p3" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-1-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-1-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Reserve stock&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow calls UpdateItem directly with the condition available &gt;= qty. If the condition fails, the saga stops with OutOfStock.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-1-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="126" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-2-badge-legend-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-2-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-2-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Payment task with a task token&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow invokes the payment function with .waitForTaskToken. Then the workflow waits for the callback. The wait has a 15-minute timeout.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-2-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="186" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-3-badge-legend-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-3-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-3-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Store the task token&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes the task token under the order ID. AWS delivers the request privately on the AWS backbone through the DynamoDB gateway endpoint.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-3-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-4-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="246" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-4-badge-legend-p3" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-4-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-4-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Internet call from the VPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function ENI sends the HTTPS request. Route table rtb-private-a sends 0.0.0.0/0 to nat-a.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-4-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-5-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="306" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s1-5-badge-legend-p3" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-5-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-5-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;SNAT by the NAT gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The NAT gateway replaces the source with its private IP 10.0.0.10. Route table rtb-public-a sends 0.0.0.0/0 to igw-shop.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-5-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s1-6-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="366" width="620" height="70" as="geometry" /></mxCell><mxCell id="step-s1-6-badge-legend-p3" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s1-6-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s1-6-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Create the payment&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The internet gateway maps 10.0.0.10 to the Elastic IP 203.0.113.11. The provider uses the order ID as idempotency key. Return path: provider → IGW → NAT GW → Lambda. The workflow keeps waiting.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s1-6-legend-p3"><mxGeometry x="52" y="0" width="568" height="70" as="geometry" /></mxCell><mxCell id="legend-head-s2-L-p3" value="&lt;div style=&quot;font-size:16px;color:#ED7100&quot;&gt;&lt;b&gt;Scenario 2 - The payment provider sends the webhook&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The payment provider starts this flow when the payment succeeds or fails.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 1 (the payment exists).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3"><mxGeometry x="0" y="456" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s2-1-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="522" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-1-badge-legend-p3" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-1-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-1-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Webhook&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The provider sends POST /api/webhooks/payment to shop.tdsynnexlab.link. WAF checks the request.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-1-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s2-2-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="582" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s2-2-badge-legend-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-2-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-2-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Origin request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;This route has no Cognito authorizer. The webhook function checks the signature instead.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-2-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s2-3-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="628" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s2-3-badge-legend-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-3-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-3-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway invokes the webhook function with the raw body and the signature header.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-3-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s2-4-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="674" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-4-badge-legend-p3" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-4-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-4-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Find the task token&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function checks the signature with the key from Secrets Manager. It reads the task token for the order ID. It ignores an event ID that it processed before.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-4-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s2-5-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="734" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s2-5-badge-legend-p3" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s2-5-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s2-5-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Callback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function calls SendTaskSuccess for a paid order or SendTaskFailure for a failed payment. Return path: Lambda → API Gateway → CloudFront → provider (200).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s2-5-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s3-L-p3" value="&lt;div style=&quot;font-size:16px;color:#7AA116&quot;&gt;&lt;b&gt;Scenario 3 - The saga writes the order and tells the customer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow continues after SendTaskSuccess.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 2 (the callback).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3"><mxGeometry x="0" y="808" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s3-1-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="874" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-1-badge-legend-p3" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-1-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-1-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Write the order&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow invokes the order function with the order data and the payment ID.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-1-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-2-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="920" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-2-badge-legend-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-2-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-2-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Pooled connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function connects to RDS Proxy with IAM authentication. The proxy keeps a pool of database connections.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-2-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s3-3-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="980" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-3-badge-legend-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-3-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-3-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;One transaction&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The proxy sends the statements to the writer in AZ-a. One transaction writes the order and its lines.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-3-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s3-4-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="1040" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-4-badge-legend-p3" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-4-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-4-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Publish OrderPlaced&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow calls PutEvents directly on the commerce bus. Scenario 5 shows the targets.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-4-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-5-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="1086" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-5-badge-legend-p3" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-5-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-5-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Push request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow invokes the ws function with the order ID and the status CONFIRMED.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-5-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-6-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="1132" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-6-badge-legend-p3" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-6-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-6-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Find the connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function reads the connection ID of the customer from the ws-connections table.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-6-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-7-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="1178" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s3-7-badge-legend-p3" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-7-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-7-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Post to the connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function calls the @connections API with the message.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-7-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s3-8-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-L-p3" connectable="0"><mxGeometry x="0" y="1224" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s3-8-badge-legend-p3" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s3-8-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s3-8-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Push&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;API Gateway sends the message on the open WebSocket. The SPA shows the order confirmation. Return path: none. The push goes one way.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s3-8-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-bg-R-p3" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4290" y="150" width="660" height="2146" as="geometry" /></mxCell><mxCell id="legend-container-R-p3" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="4310" y="170" width="620" height="2106" as="geometry" /></mxCell><mxCell id="legend-head-s4-R-p3" value="&lt;div style=&quot;font-size:16px;color:#C925D1&quot;&gt;&lt;b&gt;Scenario 4 - The saga undoes the reservation&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Compensation: the workflow catches the payment error.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Branch of Scenario 1, step 2: SendTaskFailure arrives, or the 15-minute timeout ends the wait.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3"><mxGeometry x="0" y="0" width="620" height="62" as="geometry" /></mxCell><mxCell id="step-s4-1-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="66" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-1-badge-legend-p3" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-1-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-1-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Release the stock&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Catch block calls UpdateItem. It adds the reserved quantity back to available.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-1-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s4-2-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="112" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-2-badge-legend-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-2-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-2-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Publish PaymentFailed&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow publishes PaymentFailed on the commerce bus.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-2-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s4-3-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="158" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s4-3-badge-legend-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-3-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-3-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Push request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The workflow invokes the ws function with the status PAYMENT_FAILED.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-3-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s4-4-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="204" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-4-badge-legend-p3" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-4-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-4-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Post to the connection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function reads the connection ID first, as in Scenario 3, step 6. Then it calls the @connections API.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-4-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s4-5-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="264" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s4-5-badge-legend-p3" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s4-5-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s4-5-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Push&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The SPA shows that the payment failed. Return path: none. If the Aurora write fails after the payment, the saga also refunds through Lambda payment (not drawn).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s4-5-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-head-s5-R-p3" value="&lt;div style=&quot;font-size:16px;color:#3F8624&quot;&gt;&lt;b&gt;Scenario 5 - EventBridge delivers OrderPlaced&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The commerce bus starts this flow. Three rules match the same event. Steps 1a, 1b and 1c run in parallel.&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;i&gt;Needs: Scenario 3, step 4 (OrderPlaced on the bus).&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3"><mxGeometry x="0" y="338" width="620" height="78" as="geometry" /></mxCell><mxCell id="step-s5-1a-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="420" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s5-1a-badge-legend-p3" value="1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-1a-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-1a-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Rule order-placed-notify&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The rule sends the event to the notification topic. Page 4 shows the email and the SMS.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-1a-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s5-1b-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="466" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-1b-badge-legend-p3" value="1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-1b-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-1b-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Rule order-placed-fulfil&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The rule sends the event to the order buffer queue. The queue protects the 3PL link from peaks. Page 4 shows the fulfillment.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-1b-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="step-s5-1c-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="526" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s5-1c-badge-legend-p3" value="1c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-1c-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-1c-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Rule commerce-log&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The rule invokes the producer function in the VPC.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-1c-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s5-2-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="572" width="620" height="40" as="geometry" /></mxCell><mxCell id="step-s5-2-badge-legend-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-2-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-2-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Event log&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function writes the event to the Kafka topic commerce-events with IAM authentication.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-2-legend-p3"><mxGeometry x="52" y="0" width="568" height="40" as="geometry" /></mxCell><mxCell id="step-s5-3-legend-p3" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3" connectable="0"><mxGeometry x="0" y="618" width="620" height="54" as="geometry" /></mxCell><mxCell id="step-s5-3-badge-legend-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="step-s5-3-legend-p3"><mxGeometry x="0" y="0" width="40" height="30" as="geometry" /></mxCell><mxCell id="step-s5-3-desc-legend-p3" value="&lt;div&gt;&lt;b&gt;Failed delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;If a target still fails after all retries, EventBridge sends the event to the DLQ of that rule. Return path: none. The bus archive keeps every event for replay.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-s5-3-legend-p3"><mxGeometry x="52" y="0" width="568" height="54" as="geometry" /></mxCell><mxCell id="legend-lines-R-p3" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;Solid colored arrow: one step of a scenario (the color is the scenario).&lt;br&gt;Dashed colored arrow: failure path.&lt;br&gt;Dotted grey line: association. No traffic flows on it.&lt;br&gt;Arc on a line: two lines cross. They do not connect.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3"><mxGeometry x="0" y="692" width="620" height="100" as="geometry" /></mxCell><mxCell id="legend-ips-R-p3" value="&lt;div style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Addresses&lt;/b&gt;&lt;br&gt;Private IPs come from the VPC plan (10.0.0.0/16) and the 3PL network (172.16.0.0/16). Internet addresses use the RFC 5737 documentation ranges.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;rounded=1;strokeColor=#666666;dashed=1;spacing=8;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="legend-container-R-p3"><mxGeometry x="0" y="806" width="620" height="68" as="geometry" /></mxCell><mxCell id="frame-walk-s1-p3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#007CBD;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2556" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s1-title-p3" value="&lt;b style=&quot;color:#007CBD&quot;&gt;Scenario 1 - The saga reserves stock and asks for payment - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2562" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s1-hdr0-p3" value="&lt;b&gt;Step Functions → DynamoDB&lt;/b&gt;&lt;br&gt;UpdateItem table stock, PK SKU#123&lt;br&gt;ConditionExpression available &gt;= :qty&lt;br&gt;SET available = available - :qty" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b0-p3" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-hdr1-p3" value="&lt;b&gt;Step Functions → Lambda payment&lt;/b&gt;&lt;br&gt;Invoke payment-svc (.waitForTaskToken)&lt;br&gt;Payload {orderId: o-1001, amount: 1299.00 EUR,&lt;br&gt;taskToken: AQB...}" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b1-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e1-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr0-p3" target="walk-s1-hdr1-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr2-p3" value="&lt;b&gt;Lambda payment → DynamoDB&lt;/b&gt;&lt;br&gt;PutItem table idempotency&lt;br&gt;PK PAY#o-1001, taskToken AQB...&lt;br&gt;expiresAt (TTL)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1648" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b2-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1648" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e2-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr1-p3" target="walk-s1-hdr2-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr3-p3" value="&lt;b&gt;Lambda payment → NAT gateway a&lt;/b&gt;&lt;br&gt;HTTPS POST api.payments.example/v1/payments&lt;br&gt;src 10.0.16.25 (Lambda ENI a private IP)&lt;br&gt;dst 198.51.100.40 (provider public IP)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2102" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b3-p3" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2102" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e3-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr2-p3" target="walk-s1-hdr3-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr4-p3" value="&lt;b&gt;NAT gateway a → Internet gateway&lt;/b&gt;&lt;br&gt;src 10.0.0.10 (NAT GW a private IP)&lt;br&gt;dst 198.51.100.40 (provider public IP)&lt;br&gt;SNAT by NAT GW a" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2556" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b4-p3" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2556" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e4-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr3-p3" target="walk-s1-hdr4-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s1-hdr5-p3" value="&lt;b&gt;Internet gateway → Payment provider&lt;/b&gt;&lt;br&gt;src 203.0.113.11 (NAT GW a Elastic IP)&lt;br&gt;Idempotency-Key: o-1001&lt;br&gt;metadata {orderId: o-1001}" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3010" y="2645" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s1-b5-p3" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="3010" y="2600" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s1-e5-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#007CBD;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s1-hdr4-p3" target="walk-s1-hdr5-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="frame-walk-s2-p3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2764" width="3530" height="184" as="geometry" /></mxCell><mxCell id="walk-s2-title-p3" value="&lt;b style=&quot;color:#ED7100&quot;&gt;Scenario 2 - The payment provider sends the webhook - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734" y="2770" width="3502" height="22" as="geometry" /></mxCell><mxCell id="walk-s2-hdr0-p3" value="&lt;b&gt;Payment provider → CloudFront&lt;/b&gt;&lt;br&gt;HTTPS POST /api/webhooks/payment&lt;br&gt;Payment-Signature: t=..., v1=...&lt;br&gt;body {type: payment.succeeded, orderId: o-1001}" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="2853" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s2-b0-p3" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="2808" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s2-hdr1-p3" value="&lt;b&gt;CloudFront → REST API&lt;/b&gt;&lt;br&gt;Origin request /prod/webhooks/payment&lt;br&gt;no Authorization header" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="2853" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s2-b1-p3" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1194" y="2808" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s2-e1-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s2-hdr0-p3" target="walk-s2-hdr1-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s2-hdr2-p3" value="&lt;b&gt;REST API → Lambda webhook&lt;/b&gt;&lt;br&gt;Lambda event&lt;br&gt;headers.Payment-Signature&lt;br&gt;body (raw, for the HMAC check)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1648" y="2853" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s2-b2-p3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1648" y="2808" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s2-e2-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s2-hdr1-p3" target="walk-s2-hdr2-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s2-hdr3-p3" value="&lt;b&gt;Lambda webhook → DynamoDB&lt;/b&gt;&lt;br&gt;GetItem PK PAY#o-1001 → taskToken&lt;br&gt;PutItem EVT#evt_9&lt;br&gt;(condition attribute_not_exists)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2102" y="2853" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s2-b3-p3" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2102" y="2808" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s2-e3-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s2-hdr2-p3" target="walk-s2-hdr3-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="walk-s2-hdr4-p3" value="&lt;b&gt;Lambda webhook → Step Functions&lt;/b&gt;&lt;br&gt;SendTaskSuccess&lt;br&gt;taskToken AQB...&lt;br&gt;output {paymentId: pay_77, status: PAID}" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;strokeColor=#545B64;fillColor=light-dark(#FFFFFF,#1E1E1E);spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2556" y="2853" width="420" height="79" as="geometry" /></mxCell><mxCell id="walk-s2-b4-p3" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2556" y="2808" width="28" height="28" as="geometry" /></mxCell><mxCell id="walk-s2-e4-p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="walk-s2-hdr3-p3" target="walk-s2-hdr4-p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="frame-walk-s3-p3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7AA116;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="2972" width="3530" height="199" as="geometry" /></mxCell><mxCell id="walk-s3-title-p3" value="&lt;b style=&quot;color:#7AA116&quot;&gt;Scenario 3 - The saga writes the order and tells the customer - event walk&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt; (one card per step: the request or event at that point)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteS